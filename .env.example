# Instagram login. Prefer a dedicated, authorized account.
IG_USERNAME=
IG_PASSWORD=

# Comma-separated profiles or niches to analyze, without @ or with @.
IG_TARGET_PROFILES=instagram,creators
IG_MAX_REELS_PER_PROFILE=5

# Playwright behavior
IG_HEADLESS=false
IG_SLOW_MO_MS=80
IG_MIN_DELAY_MS=2200
IG_MAX_DELAY_MS=6500
IG_STORAGE_STATE=playwright/.auth/instagram.json
IG_OUTPUT_FILE=playwright/data/reels-capture.json

# Supabase is optional. If empty, data is saved only as JSON.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=instagram_reels
